<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meu Arquivo de Projetos</title>
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <header>
    <div>
      <p class="etiqueta">ARQUIVO PESSOAL</p>
      <h1>Minha Oficina</h1>
    </div>

    <button id="abrir-formulario">+ Novo projeto</button>
  </header>

  <nav>
    <button class="aba ativa" data-secao="projetos">Projetos</button>
    <button class="aba" data-secao="jogos">Jogos</button>
    <button class="aba" data-secao="jornal">Jornal</button>
  </nav>

  <main>
    <section id="projetos" class="secao ativa">
      <h2>Projetos</h2>
      <div id="lista-projetos" class="grade"></div>
    </section>

    <section id="jogos" class="secao">
      <h2>Jogos</h2>
      <div id="lista-jogos" class="grade"></div>
    </section>

    <section id="jornal" class="secao">
      <h2>Jornal</h2>
      <div id="lista-jornal" class="grade"></div>
    </section>
  </main>

  <dialog id="formulario-projeto">
    <form id="novo-projeto">
      <button type="button" id="fechar-formulario" class="fechar">×</button>

      <h2>Novo projeto</h2>

      <label>
        Nome
        <input id="nome-projeto" type="text" required>
      </label>

      <label>
        Descrição
        <textarea id="descricao-projeto" rows="4"></textarea>
      </label>

      <label>
        Status
        <select id="status-projeto">
          <option value="Ideia">Ideia</option>
          <option value="Planejamento">Planejamento</option>
          <option value="Em andamento">Em andamento</option>
          <option value="Concluído">Concluído</option>
        </select>
      </label>

      <button type="submit">Criar pasta</button>
    </form>
  </dialog>

  <script src="js/app.js"></script>
</body>
</html>
